# OpenPERouter FRR Configuration Template — EVPN Route Reflector (ISIS + SRv6)
# Rendered by generate-config.sh using envsubst
#
# Peering model:
#   - TOR (direct):     ipv4 vpn + ipv6 vpn  (SRv6 routes only)
#   - EVPN-CLIENTS:     l2vpn evpn only (reflected)
#
# Variables:
#   ${UNDERLAY_NIC}, ${BGP_AS}, ${LOOPBACK_V6}, ${CLUSTER_ID}, ${TOR_LOOPBACK}
#   ${VRF_NAME}, ${L2_VNI}, ${L3_VPN}
#   ${L2_GATEWAY_IP}, ${L2_GATEWAY_IP_V6}
#   ${EVPN_LISTEN_RANGE}     - IPv6 prefix for dynamic EVPN client peers
#   ${IPV4_TUNNEL_CIDR}, ${IPV6_TUNNEL_CIDR}, ${ISIS_BASENET}, ${SRV6_LOCATOR_PREFIX}
#   ${RR_LOOPBACK_0}, ${RR_LOOPBACK_1}, ${RR_LOOPBACK_2}

rawfrrconfigs:
  - priority: 100
    rawConfig: |
      router bgp ${BGP_AS}
       neighbor ${RR_LOOPBACK_0} update-source ${LOOPBACK_V6}
       neighbor ${RR_LOOPBACK_1} update-source ${LOOPBACK_V6}
       neighbor ${RR_LOOPBACK_2} update-source ${LOOPBACK_V6}

underlays:
  - asn: ${BGP_AS}
    tunnelEndpoint:
      cidrs:
        - ${IPV4_TUNNEL_CIDR}
        - ${IPV6_TUNNEL_CIDR}
    interfaces:
    - type: NetworkDevice
      networkDevice:
        interfaceName: ${UNDERLAY_NIC}
    routerIDCIDR: 10.0.0.0/24
    isis:
      baseNet: "${ISIS_BASENET}"
      level: 1
    srv6:
      encapBehavior: "H.Encaps.Red"
      locator:
        basePrefix: "${SRV6_LOCATOR_PREFIX}"
        format: "usid-f3216"
    nodeSelector:
      matchExpressions:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
    routeReflector:
      clusterID: ${CLUSTER_ID}
    neighbors:
      - type: Internal
        address: ${TOR_LOOPBACK}
      - type: Internal
        listenRange: ${EVPN_LISTEN_RANGE}
        addressFamilies:
          - type: ipv4unicast
            properties:
              - type: routeReflectorClient
          - type: evpn
            properties:
              - type: routeReflectorClient
      - type: Internal
        address: ${RR_LOOPBACK_0}
        addressFamilies:
          - type: ipv4unicast
          - type: evpn
      - type: Internal
        address: ${RR_LOOPBACK_1}
        addressFamilies:
          - type: ipv4unicast
          - type: evpn
      - type: Internal
        address: ${RR_LOOPBACK_2}
        addressFamilies:
          - type: ipv4unicast
          - type: evpn

l2vnis:
  - vni: ${L2_VNI}
    routingDomain:
      type: L3VPN
      l3vpn:
        name: ${VRF_NAME}
    vxlanport: 4789
    gatewayIPs:
      - "${L2_GATEWAY_IP}"
      - "${L2_GATEWAY_IP_V6}"
    hostMaster:
      type: LinuxBridge
      linuxBridge:
        lifecycle: External
        name: br0
l3vpns:
  - name: ${VRF_NAME}
    vrf: ${VRF_NAME}
    rdAssignedNumber: ${L3_VPN}
    exportRTs:
    - "${BGP_AS}:${L3_VPN}"
    importRTs:
    - "${BGP_AS}:${L3_VPN}"
